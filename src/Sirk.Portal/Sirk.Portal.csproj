<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Sirk.Portal</AssemblyName>
    <RootNamespace>Sirk.Portal</RootNamespace>
    <Version>3.0.0-dev.1</Version>
    <FileVersion>3.0.0.1</FileVersion>
    <InformationalVersion>3.0.0-dev.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sirk.Portal.ProtocolTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../public/**"
             Link="public/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <PortalPublicSource>$(MSBuildProjectDirectory)/../../public</PortalPublicSource>
  </PropertyGroup>

  <Target Name="GeneratePortalBuildBundles"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --bundle-assets &quot;$(PortalPublicSource)&quot; &quot;$(TargetDir)public/assets/bundles&quot;" />
  </Target>

  <Target Name="GeneratePortalPublishBundles" AfterTargets="Publish">
    <Exec Command="dotnet &quot;$(PublishDir)$(AssemblyName).dll&quot; --bundle-assets &quot;$(PortalPublicSource)&quot; &quot;$(PublishDir)public/assets/bundles&quot;" />
  </Target>
</Project>
