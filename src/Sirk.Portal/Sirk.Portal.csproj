<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Sirk.Portal</AssemblyName>
    <RootNamespace>Sirk.Portal</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sirk.Portal.ProtocolTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../public/**"
             Link="public/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../release-trusted-keys.json"
             Link="release-trusted-keys.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <PortalPublicSource>$(MSBuildProjectDirectory)/../../public</PortalPublicSource>
    <PortalBundleHostDll>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).dll</PortalBundleHostDll>
  </PropertyGroup>

  <Target Name="GeneratePortalBuildBundles"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipPortalBundleGeneration)' != 'true' and '$(RuntimeIdentifier)' == ''">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --bundle-assets &quot;$(PortalPublicSource)&quot; &quot;$(TargetDir)public/assets/bundles&quot;" />
  </Target>

  <Target Name="PreparePortalPublishBundleHost"
          BeforeTargets="GeneratePortalPublishBundles"
          Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=;SelfContained=false;PublishReadyToRun=false;SkipPortalBundleGeneration=true" />
  </Target>

  <Target Name="GeneratePortalPublishBundles" AfterTargets="Publish">
    <Exec Command="dotnet &quot;$(PortalBundleHostDll)&quot; --bundle-assets &quot;$(PortalPublicSource)&quot; &quot;$(PublishDir)public/assets/bundles&quot;" />
  </Target>
</Project>