<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Sirk.Portal</AssemblyName>
    <RootNamespace>Sirk.Portal</RootNamespace>
    <Version>3.0.0-dev.1</Version>
    <FileVersion>3.0.0.1</FileVersion>
    <InformationalVersion>3.0.0-dev.1</InformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../public/**"
             Link="public/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
